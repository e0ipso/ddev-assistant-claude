#ddev-generated
ARG BASE_IMAGE
FROM $BASE_IMAGE

# Install Claude Code into /usr/local/bin, which is on PATH for every shell type
# (login, interactive `ddev ssh`, and non-interactive `ddev exec`) and lives in the
# image layer — outside the web user's home, which DDEV recreates on every restart.
# Installing here means `claude` is available immediately with no per-start copy hook
# that could fail and abort `ddev start`.
# Using cp -L dereferences the installer's symlink so the standalone binary is copied
# (not a dangling link); the binary is self-contained and runs regardless of ownership.
RUN curl -fsSL https://claude.ai/install.sh | bash && \
    cp -L /root/.local/bin/claude /usr/local/bin/claude && \
    chmod 755 /usr/local/bin/claude
